# TypeSafe SDK reads the official variable from the process environment.
TYPESAFE_API_KEY=replace-me

# Optional SDK overrides (already defaults).
# TYPESAFE_DEFAULT_MODEL=jev-latest
# TYPESAFE_BASE_URL=https://api.typesafe.ai

# Optional local aliases understood by tfm-agent (official name remains TYPESAFE_API_KEY).
# JEV_API_KEY=replace-me

# Optional discovery overrides (never hardcode username paths).
# TFM_AGENT_STEAM_ROOT=
# TFM_AGENT_CONFIG=
